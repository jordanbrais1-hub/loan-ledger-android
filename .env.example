# Google OAuth "Web application" client ID (ends in .apps.googleusercontent.com).
# Android sign-in uses this too; see README → "Google sign-in setup".
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Currency pre-selected for new loans (CRC or USD; each loan picks its own).
NEXT_PUBLIC_CURRENCY=CRC
# Locale used to format numbers and dates (BCP 47).
NEXT_PUBLIC_LOCALE=en-US
