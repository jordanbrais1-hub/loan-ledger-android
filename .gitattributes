# Normalize line endings in the repo; check out with the platform's native endings.
* text=auto eol=lf

# Windows scripts need CRLF to run.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never diff or convert.
*.png  binary
*.jpg  binary
*.ico  binary
*.jar  binary
*.jks  binary
*.keystore binary
*.apk  binary
*.aab  binary
